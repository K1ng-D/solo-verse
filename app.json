{
  "expo": {
    "name": "SoloVerse",
    "slug": "soloverse",
    "scheme": "soloverse",
    "version": "3.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icons/guardian.png",
    "splash": {
      "image": "./assets/art/pendhapa.png",
      "resizeMode": "cover",
      "backgroundColor": "#241B16"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "plugins": [
      "expo-router",
      "expo-audio"
    ],
    "android": {
      "package": "com.soloverse.heritage",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/guardian.png",
        "backgroundColor": "#241B16"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.soloverse.heritage",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fcc66d2e-37a6-4aed-81f7-49437c18308e"
      }
    },
    "owner": "nextylabs"
  }
}
